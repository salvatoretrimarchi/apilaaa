# Rust
target/
# Cargo.lock is versioned on purpose: this crate is a binary, so the lockfile
# is what makes a build reproducible — and it is what pins the vendored
# rawloader patched in from Cargo.toml.

# Input data (camera RAW)
res*/
*.ARW
*.arw
*.CR2
*.CR3
*.NEF
*.RAF
*.ORF

# Image outputs. Rendered comparisons are megabytes each and are reproduced
# from the output DNGs on demand, so none of them belong here.
*.tif
*.tiff
*.dng
*.png
*.jpg
*.jpeg

# Development sidecars and local comparison workspace
*.xmp
comparison/

# Editor and IDE settings
.vscode/
.idea/

# Benchmarks and profiling
.bench/

# Logs
*.log

# System junk
.Trash-*/
.DS_Store
